# Install as /etc/fim-ipl/fim.env with root:root ownership and mode 0600.
FIM_STRICT_SECRETS=1
FIM_REQUIRE_EXTERNAL_SECRETS=1
FIM_REQUIRE_LOCAL_API=1
FIM_SERVER_PORT=127.0.0.1:8080
# Cookie sesi: 1 = atribut Secure aktif (produksi HTTPS). 0 hanya untuk dev
# HTTP lokal; jangan 0 di produksi.
FIM_COOKIE_SECURE=1
FIM_JWT_SECRET=replace-with-at-least-32-random-characters
FIM_ADMIN_PASSWORD=replace-with-a-strong-password
FIM_TELEGRAM_TOKEN=
FIM_TELEGRAM_CHAT_ID=
